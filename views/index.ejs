<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Capital quiz</title>
    <link rel="stylesheet" href="styles/style.css">
</head>
<body>
    <h1>Capital quiz</h1>
    <h2>Score: <%=score%></h2>

    <div class="container">
        <form method="POST" action="/guess">
            <label for="capital">What is the capital of <%=country%></label>
            <input name="capital"></input>
            <input type="submit" value="Submit"></input>
        </form>
    </div>

    <script>
        var wasCorrect = "<%=wasCorrect%>";
        if (wasCorrect === "false") {
            alert('Game over! The right answer was: <%=prevCapital%>. Your score: <%= prevScore %>');
        }
    </script>
</body>
</html>